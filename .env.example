# northstar_tax .env.example — copy to .env and customize. Never commit .env.

# ---- Branding (the rename pivots; mirror Northstar's discipline) ----
APP_NAME=Northstar Tax
APP_SLUG=northstar-tax
APP_TAGLINE=Prepare your return. Review it. File it yourself.

# ---- Server ----
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---- Reference data (tax-year constants) ----
CONSTANTS_DIR=./data/constants
